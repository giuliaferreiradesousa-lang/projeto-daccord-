    "test:e2e:setup": "node scripts/run-e2e.mjs --setup",
    "demo:artifacts": "node scripts/export-demo-artifacts.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.ts postcss.config.mjs eslint.config.mjs playwright.config.mjs scripts/check-demo.mjs scripts/run-e2e.mjs scripts/export-demo-artifacts.mjs tests/e2e --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:typography": "node --test tests/typography.test.mjs",
    "test:carousel": "node --experimental-strip-types --test tests/carousel.test.mjs",
    "test:pagination": "node --experimental-strip-types --test tests/pagination.test.mjs"
  },
  "dependencies": {
    "@fontsource/belleza": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/staatliches": "5.3.0",
    "framer-motion": "13.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
